{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "clinic-saas",
    "Audience": "clinic-saas-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "RefreshTokenDays": 14,
    "PasswordResetTokenMinutes": 30,
    "EmailVerificationTokenHours": 48,
    "RequireConfirmedEmail": false,
    "AppBaseUrl": "http://localhost:3000"
  },
  "Email": {
    "Provider": ""
  },
  "Saas": {
    "DefaultPlanCode": "basic",
    "CatalogHiddenPlanCodes": [ "free" ]
  },
  "FeatureFlags": {
    "DisabledFeatures": []
  },
  "RateLimiting": {
    "AuthPerMinute": 10,
    "RefreshPerMinute": 120,
    "SensitivePer15Minutes": 5,
    "ApiPerMinute": 300
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
